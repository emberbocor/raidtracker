{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Shows the current wave, the total waves and the raiders left on the raid boss bar, and makes the last raiders of a wave glow. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/raidtracker",
    "sources": "https://github.com/emberbocor/raidtracker",
    "issues": "https://github.com/emberbocor/raidtracker/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.emberbocor.raidtracker.RaidTrackerFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21"
  }
}
